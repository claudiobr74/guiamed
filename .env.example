# Copie para .env.local. Nunca commite secrets.

# Sessão local (obrigatória em produção)
SESSION_SECRET=

# Supabase (produção). Crie um projeto NOVO chamado GuiaMed.
# Não reutilize projetos de outros produtos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: modelo para auxílio de justificativa clínica.
# Sem esta chave, o texto é montado só com os fatos informados (sem invenção).
OPENAI_API_KEY=
