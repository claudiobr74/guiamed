# Copie para .env.local. Nunca commite secrets.

# Sessão HMAC do Next.js (obrigatória em produção)
SESSION_SECRET=

# Firebase — projeto guiamed-918ee
NEXT_PUBLIC_FIREBASE_PROJECT_ID=guiamed-918ee
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=guiamed-918ee.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=guiamed-918ee.appspot.com

# Chave Web apiKey (pública no cliente). O app já usa esta chave como padrão do guiamed-918ee.
# Na Vercel só é obrigatório sobrescrever se o projeto Firebase mudar.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAKihHLhd2aL9sapkJZHty1zgPpZQRdW7k

# Credencial Admin — NÃO é e-mail/senha de login.
# Console Firebase > Configurações do projeto > Contas de serviço > Gerar nova chave privada.
# O arquivo JSON baixado tem project_id, client_email e private_key.
#
# Opção 1: cole o JSON INTEIRO em uma linha (não só o e-mail firebase-adminsdk-...)
FIREBASE_SERVICE_ACCOUNT=
#
# Opção 2: campos do mesmo JSON
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@guiamed-918ee.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n.....\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Opcional: modelo para auxílio de justificativa clínica.
# Sem esta chave, o texto é montado só com os fatos informados (sem invenção).
OPENAI_API_KEY=
