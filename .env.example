# Copie para .env.local. Nunca commite secrets.

# Sessão HMAC do Next.js (obrigatória em produção)
SESSION_SECRET=

# Firebase — projeto guiamed-918ee
NEXT_PUBLIC_FIREBASE_PROJECT_ID=guiamed-918ee
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=guiamed-918ee.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=guiamed-918ee.appspot.com

# Chave Web apiKey — começa com AIzaSy
# Console Firebase > Configurações do projeto (engrenagem) > Seus apps > app Web
# > Configuração do SDK. Campo apiKey.
# Não use o par de chaves Web Push (Cloud Messaging); esse valor começa com "B" e não autentica.
NEXT_PUBLIC_FIREBASE_API_KEY=

# Credencial Admin (Console > Contas de serviço > Gerar nova chave privada)
# Opção 1: JSON completo em uma linha
FIREBASE_SERVICE_ACCOUNT=

# Opção 2: campos separados (use \n na chave privada)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Opcional: modelo para auxílio de justificativa clínica.
# Sem esta chave, o texto é montado só com os fatos informados (sem invenção).
OPENAI_API_KEY=
